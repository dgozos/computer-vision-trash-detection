# ── YOLO / Ultralytics ───────────────────────────────────
# Pretrained weight downloads (re-downloadable, large files)
yolo11n.pt
yolo11s.pt
yolo11m.pt
yolo11l.pt
yolo11x.pt
yolo26n.pt

# Training runs — keep best weights, ignore the rest
# Uncomment the next line if you want to exclude ALL run artifacts:
# runs/

# Cache files generated by YOLO during training/validation
*.cache
*.cache.*

# ── Model weights (large files) ──────────────────────────
# Track best.pt via Git LFS or exclude entirely if too large
# Uncomment if you do NOT want weights in the repo:
# *.pt

# Last checkpoint (redundant if best.pt is kept)
runs/**/weights/last.pt

# ── Dataset ──────────────────────────────────────────────
# Exclude raw dataset images (too large for GitHub)
# Keep data.yaml for reproducibility
train/
valid/
test/
*.zip
*.tar.gz
*.tar

# ── Logs & outputs ───────────────────────────────────────
*.log
wandb/
mlruns/
lightning_logs/

